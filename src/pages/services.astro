---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Services - ${SITE_TITLE}`} description="Our comprehensive range of bespoke covers, canopies and canvas solutions for marine, commercial and industrial applications." />
	</head>
	<body class="bg-background text-text">
		<Header />
		<main>
			<!-- Page Header -->
			<section class="bg-gradient-to-br from-deep-purple via-primary to-electric-blue text-white py-20 relative overflow-hidden">
				<!-- Floating decorative shapes -->
				<div class="absolute top-10 left-20 w-32 h-32 bg-copper/20 rounded-full animate-blob blur-xl"></div>
				<div class="absolute bottom-10 right-20 w-40 h-40 bg-white/10 rounded-full animate-blob blur-xl" style="animation-delay: 2s;"></div>
				
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
					<h1 class="text-4xl lg:text-5xl font-bold mb-4">What We Make</h1>
					<p class="text-xl text-white/90 max-w-3xl">Canvas, PVC, covers, panels and practical fabric wizardry</p>
				</div>
			</section>

			<!-- Marine Products -->
			<section class="py-20 bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div>
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Canal Boat & Marine Covers</h2>
							<p class="text-lg text-text/70 mb-6">We specialise in marine canvas work for narrowboats, leisure craft and commercial vessels. Our marine covers are designed to withstand the harsh conditions of life on the water while providing excellent protection.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Cratch covers and canopies</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Cockpit covers and boat canopies</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Winter covers and storage covers</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Porthole covers and bungs</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Clear PVC windows and vision panels</span>
								</li>
							</ul>
						</div>
						<div class="bg-background rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<rect x="30" y="60" width="140" height="80" fill="none" stroke="currentColor" stroke-width="2" rx="5"/>
								<path d="M30 100 L170 100" stroke="currentColor" stroke-width="1" stroke-dasharray="5,5"/>
								<path d="M50 60 L50 140" stroke="currentColor" stroke-width="2"/>
								<path d="M90 60 L90 140" stroke="currentColor" stroke-width="2"/>
								<path d="M130 60 L130 140" stroke="currentColor" stroke-width="2"/>
								<path d="M150 60 L150 140" stroke="currentColor" stroke-width="2"/>
							</svg>
						</div>
					</div>
				</div>
			</section>

			<!-- Commercial Covers -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 bg-white rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<rect x="40" y="40" width="120" height="120" fill="none" stroke="currentColor" stroke-width="2" rx="5"/>
								<rect x="60" y="60" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="110" y="60" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="60" y="110" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="110" y="110" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"/>
							</svg>
						</div>
						<div class="order-1 lg:order-2">
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Commercial & Industrial Covers</h2>
							<p class="text-lg text-text/70 mb-6">Our commercial covers are designed for durability and practicality. We work with businesses across various sectors to provide protective solutions that stand up to daily use and challenging environments.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Equipment and machinery covers</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Industrial protection systems</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Warehouse and storage covers</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Vehicle covers and tarps</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Custom industrial fabric solutions</span>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- Canopies -->
			<section class="py-20 bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div>
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Canopies & Shelters</h2>
							<p class="text-lg text-text/70 mb-6">We design and manufacture canopies for a wide range of applications. From residential awnings to commercial shelter systems, our canopies provide effective protection from the elements while enhancing the usability of outdoor spaces.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Residential and domestic canopies</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Commercial shop canopies and awnings</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Walkway and shelter canopies</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Smoking shelter canopies</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Custom framework and fabric combinations</span>
								</li>
							</ul>
						</div>
						<div class="bg-background rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<path d="M20 150 L100 50 L180 150" fill="none" stroke="currentColor" stroke-width="2"/>
								<line x1="20" y1="150" x2="180" y2="150" stroke="currentColor" stroke-width="2"/>
								<line x1="100" y1="50" x2="100" y2="150" stroke="currentColor" stroke-width="2"/>
								<line x1="60" y1="100" x2="60" y2="150" stroke="currentColor" stroke-width="2"/>
								<line x1="140" y1="100" x2="140" y2="150" stroke="currentColor" stroke-width="2"/>
							</svg>
						</div>
					</div>
				</div>
			</section>

			<!-- Gazebo Panels -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 bg-white rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<rect x="30" y="30" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="110" y="30" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="30" y="110" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
								<rect x="110" y="110" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
							</svg>
						</div>
						<div class="order-1 lg:order-2">
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Gazebo Panels & Outdoor Rooms</h2>
							<p class="text-lg text-text/70 mb-6">We supply replacement and custom gazebo panels for all major gazebo systems. Whether you need a single replacement panel or a complete set, we can manufacture panels to your exact specifications.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Replacement side panels</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Zipped door panels and entrances</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Clear window panels</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Solid and panel combinations</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Custom sizing and colours available</span>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- PVC Fabrication -->
			<section class="py-20 bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div>
							<h2 class="text-3xl font-bold text-deep-purple mb-6">PVC Fabrication</h2>
							<p class="text-lg text-text/70 mb-6">Our PVC fabrication services cover a wide range of applications. From clear windows and transparent panels to heavy-duty industrial PVC products, we have the expertise to deliver quality results.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Clear PVC windows and vision panels</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Welded PVC seams and joints</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Custom PVC enclosures and covers</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Industrial PVC fabrication</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Transparent fabric solutions</span>
								</li>
							</ul>
						</div>
						<div class="bg-background rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<rect x="40" y="40" width="120" height="120" fill="none" stroke="currentColor" stroke-width="2" rx="5"/>
								<circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="2"/>
								<path d="M40 100 L160 100" stroke="currentColor" stroke-width="1" stroke-dasharray="5,5"/>
								<path d="M100 40 L100 160" stroke="currentColor" stroke-width="1" stroke-dasharray="5,5"/>
							</svg>
						</div>
					</div>
				</div>
			</section>

			<!-- Repairs -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div class="order-2 lg:order-1 bg-white rounded-xl p-8 aspect-square flex items-center justify-center">
							<svg viewBox="0 0 200 200" class="w-full h-full text-primary/40">
								<path d="M100 40 L120 60 L140 40 L160 60 L140 80 L160 100 L140 120 L120 100 L100 120 L80 100 L60 120 L40 100 L60 80 L40 60 L60 40 L80 60 Z" fill="none" stroke="currentColor" stroke-width="2"/>
								<circle cx="100" cy="80" r="15" fill="none" stroke="currentColor" stroke-width="2"/>
							</svg>
						</div>
						<div class="order-1 lg:order-2">
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Repairs & Alterations</h2>
							<p class="text-lg text-text/70 mb-6">We offer comprehensive repair services for all types of covers and canvas products. Rather than replacing your existing cover, we can often repair and refurbish it to extend its life and save you money.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Canvas and fabric repairs</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Zip replacements and repairs</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Restitching and seam reinforcement</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>PVC window replacement</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Complete refurbishment services</span>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- Custom Projects -->
			<section class="py-20 bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div>
							<h2 class="text-3xl font-bold text-deep-purple mb-6">Custom Projects</h2>
							<p class="text-lg text-text/70 mb-6">If you have a unique requirement that doesn't fit into our standard service categories, we're here to help. We thrive on custom projects and enjoy the challenge of creating bespoke solutions for our customers.</p>
							<ul class="space-y-3 text-text/80">
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>One-off bespoke fabrications</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Prototype and small batch production</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Specialist material sourcing</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Design consultation and advice</span>
								</li>
								<li class="flex items-start">
									<svg class="w-5 h-5 text-primary mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
									<span>Collaborative problem solving</span>
								</li>
							</ul>
						</div>
						<div class="bg-background rounded-xl p-8 aspect-square flex items-center justify-center">
