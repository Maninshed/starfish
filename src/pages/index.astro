---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-background text-text">
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="relative bg-gradient-to-br from-deep-purple via-primary to-electric-blue text-white py-20 lg:py-32 overflow-hidden">
				<!-- Floating decorative shapes -->
				<div class="absolute top-20 left-10 w-32 h-32 bg-copper/20 rounded-full animate-blob blur-xl"></div>
				<div class="absolute bottom-20 right-10 w-48 h-48 bg-electric-blue/20 rounded-full animate-blob blur-xl" style="animation-delay: 2s;"></div>
				<div class="absolute top-1/2 left-1/4 w-24 h-24 bg-primary/30 rounded-full animate-blob blur-xl" style="animation-delay: 4s;"></div>
				
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
					<div class="grid lg:grid-cols-2 gap-12 items-center">
						<div>
							<h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold mb-6 leading-tight">
								Covers, Canopies & Curious Canvas Things
							</h1>
							<p class="text-xl text-white/90 mb-8 leading-relaxed">
								We make and repair custom covers, canopies, PVC panels, cratch covers, gazebo sides, porthole bungs and all sorts of made-to-measure fabric solutions for life outdoors.
							</p>
							<div class="flex flex-col sm:flex-row gap-4">
								<a href="/contact" class="bg-copper text-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-deep-purple transition-all transform hover:-translate-y-1 hover:shadow-lg hover:shadow-copper/30 text-center">
									Start a Project
								</a>
								<a href="/gallery" class="border-2 border-white/50 text-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-deep-purple transition-all transform hover:-translate-y-1 text-center">
									See What We Make
								</a>
							</div>
						</div>
						<div class="relative">
							<div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 aspect-square flex items-center justify-center relative animate-float">
								<!-- Abstract canvas/fabric illustration with playful elements -->
								<svg viewBox="0 0 400 300" class="w-full h-full text-white/80">
									<!-- Patchwork-style blocks -->
									<rect x="50" y="50" width="120" height="80" fill="none" stroke="currentColor" stroke-width="2" rx="5" transform="rotate(-5 110 90)"/>
									<rect x="180" y="40" width="100" height="90" fill="none" stroke="currentColor" stroke-width="2" rx="5" transform="rotate(3 230 85)"/>
									<rect x="80" y="140" width="140" height="70" fill="none" stroke="currentColor" stroke-width="2" rx="5" transform="rotate(2 150 175)"/>
									<rect x="230" y="130" width="90" height="100" fill="none" stroke="currentColor" stroke-width="2" rx="5" transform="rotate(-4 275 180)"/>
									
									<!-- Stitching lines -->
									<path d="M60 70 L160 110" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4"/>
									<path d="M200 60 L270 130" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4"/>
									<path d="M100 150 L210 180" stroke="currentColor" stroke-width="1" stroke-dasharray="4,4"/>
									
									<!-- Floating starfish motifs -->
									<g transform="translate(320, 60)" class="animate-wiggle">
										<path d="M0 -20 C2 -13, 8 -10, 12 -5 C18 -6, 25 -4, 30 2 C28 9, 25 14, 22 22 C28 26, 35 29, 38 36 C32 42, 28 46, 22 52 C25 59, 22 66, 18 69 C12 66, 8 62, 2 60 C-2 66, -5 69, -10 70 C-12 64, -14 59, -18 54 C-25 58, -32 56, -36 50 C-30 44, -26 40, -20 34 C-24 28, -22 20, -18 16 C-12 18, -8 22, -4 26 C-4 18, -3 12, -2 8 C4 10, 8 14, 12 18 C12 10, 13 4, 14 0" fill="none" stroke="currentColor" stroke-width="1.5"/>
									</g>
									
									<g transform="translate(60, 220) scale(0.6)" class="animate-wiggle" style="animation-delay: 1s;">
										<path d="M0 -20 C2 -13, 8 -10, 12 -5 C18 -6, 25 -4, 30 2 C28 9, 25 14, 22 22 C28 26, 35 29, 38 36 C32 42, 28 46, 22 52 C25 59, 22 66, 18 69 C12 66, 8 62, 2 60 C-2 66, -5 69, -10 70 C-12 64, -14 59, -18 54 C-25 58, -32 56, -36 50 C-30 44, -26 40, -20 34 C-24 28, -22 20, -18 16 C-12 18, -8 22, -4 26 C-4 18, -3 12, -2 8 C4 10, 8 14, 12 18 C12 10, 13 4, 14 0" fill="none" stroke="currentColor" stroke-width="1.5"/>
									</g>
									
									<!-- Decorative stitching circles -->
									<circle cx="150" cy="150" r="30" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3,3"/>
									<circle cx="250" cy="100" r="20" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3,3"/>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Services Overview -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-16">
						<h2 class="text-3xl lg:text-4xl font-bold text-deep-purple mb-4">What We Make</h2>
						<p class="text-lg text-text/70 max-w-2xl mx-auto">Canvas, PVC, covers, panels and practical fabric wizardry</p>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						<!-- Service Card 1 -->
						<div class="bg-gradient-to-br from-primary/10 to-electric-blue/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:rotate-1 group border-2 border-transparent hover:border-copper/50">
							<div class="bg-primary w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-electric-blue transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Canal Boat & Cratch Covers</h3>
							<p class="text-text/70">Custom covers for narrowboats, cratch covers and marine canvas solutions.</p>
						</div>

						<!-- Service Card 2 -->
						<div class="bg-gradient-to-br from-electric-blue/10 to-deep-purple/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-electric-blue/20 transition-all transform hover:-translate-y-2 hover:-rotate-1 group border-2 border-transparent hover:border-copper/50">
							<div class="bg-electric-blue w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-primary transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Gazebo Panels & Outdoor Rooms</h3>
							<p class="text-text/70">Replacement gazebo panels, side screens and outdoor weather protection.</p>
						</div>

						<!-- Service Card 3 -->
						<div class="bg-gradient-to-br from-deep-purple/10 to-primary/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-deep-purple/20 transition-all transform hover:-translate-y-2 hover:rotate-1 group border-2 border-transparent hover:border-copper/50">
							<div class="bg-deep-purple w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-electric-blue transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">PVC Windows & Clear Panels</h3>
							<p class="text-text/70">Clear PVC panels, windows and transparent fabric solutions.</p>
						</div>

						<!-- Service Card 4 -->
						<div class="bg-gradient-to-br from-copper/10 to-primary/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-copper/20 transition-all transform hover:-translate-y-2 hover:-rotate-1 group border-2 border-transparent hover:border-copper">
							<div class="bg-copper w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-deep-purple transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Bespoke Covers</h3>
							<p class="text-text/70">Custom-designed fabric and PVC solutions for your specific needs.</p>
						</div>

						<!-- Service Card 5 -->
						<div class="bg-gradient-to-br from-primary/10 to-copper/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:rotate-1 group border-2 border-transparent hover:border-copper/50">
							<div class="bg-primary w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-copper transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Repairs & Alterations</h3>
							<p class="text-text/70">Expert repair services to extend the life of your existing covers.</p>
						</div>

						<!-- Service Card 6 -->
						<div class="bg-gradient-to-br from-electric-blue/10 to-copper/10 rounded-2xl p-6 hover:shadow-xl hover:shadow-electric-blue/20 transition-all transform hover:-translate-y-2 hover:-rotate-1 group border-2 border-transparent hover:border-copper/50">
							<div class="bg-electric-blue w-16 h-16 rounded-xl flex items-center justify-center mb-4 group-hover:animate-wiggle group-hover:bg-copper transition-colors">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Odd Jobs & One-Offs</h3>
							<p class="text-text/70">Weird little problems? Strange fabric challenges? We'll have a look.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Why Choose Starfish -->
			<section class="py-20 bg-white relative overflow-hidden">
				<!-- Decorative background elements -->
				<div class="absolute top-10 right-20 w-40 h-40 bg-primary/10 rounded-full animate-blob blur-2xl"></div>
				<div class="absolute bottom-10 left-20 w-32 h-32 bg-copper/10 rounded-full animate-blob blur-2xl" style="animation-delay: 3s;"></div>
				
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
					<div class="text-center mb-16">
						<h2 class="text-3xl lg:text-4xl font-bold text-deep-purple mb-4">Why Starfish?</h2>
						<p class="text-lg text-text/70 max-w-2xl mx-auto">Made to measure, made to last, made for real-world use</p>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
						<div class="text-center group">
							<div class="bg-gradient-to-br from-primary to-electric-blue w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-4 transform group-hover:rotate-6 group-hover:scale-110 transition-all shadow-lg shadow-primary/30">
								<svg class="w-10 h-10 text-white group-hover:animate-wiggle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Custom Made</h3>
							<p class="text-text/70">Every project built to suit your weird and wonderful requirements.</p>
						</div>
						<div class="text-center group">
							<div class="bg-gradient-to-br from-electric-blue to-deep-purple w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-4 transform group-hover:-rotate-6 group-hover:scale-110 transition-all shadow-lg shadow-electric-blue/30">
								<svg class="w-10 h-10 text-white group-hover:animate-wiggle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Built to Last</h3>
							<p class="text-text/70">Heavy-duty materials and proven construction methods.</p>
						</div>
						<div class="text-center group">
							<div class="bg-gradient-to-br from-deep-purple to-copper w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-4 transform group-hover:rotate-6 group-hover:scale-110 transition-all shadow-lg shadow-deep-purple/30">
								<svg class="w-10 h-10 text-white group-hover:animate-wiggle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Repair & Refurbishment</h3>
							<p class="text-text/70">Extend the life of existing covers and canopies.</p>
						</div>
						<div class="text-center group">
							<div class="bg-gradient-to-br from-copper to-primary w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-4 transform group-hover:-rotate-6 group-hover:scale-110 transition-all shadow-lg shadow-copper/30">
								<svg class="w-10 h-10 text-white group-hover:animate-wiggle" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
								</svg>
							</div>
							<h3 class="text-xl font-bold text-deep-purple mb-2">Personal Service</h3>
							<p class="text-text/70">Friendly advice from design through installation.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Work -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-16">
						<h2 class="text-3xl lg:text-4xl font-bold text-deep-purple mb-4">Recent Makes</h2>
						<p class="text-lg text-text/70 max-w-2xl mx-auto">A selection of our curious canvas creations</p>
					</div>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						<div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-primary/20 to-electric-blue/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-primary/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
								</svg>
								<div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<h3 class="text-xl font-bold text-deep-purple mb-2">Narrowboat Cratch Cover</h3>
								<p class="text-text/70">Custom fitted cratch cover with reinforced seams and clear PVC windows.</p>
							</div>
						</div>
						<div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl hover:shadow-electric-blue/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-electric-blue/20 to-deep-purple/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-electric-blue/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
								</svg>
								<div class="absolute inset-0 bg-electric-blue/0 group-hover:bg-electric-blue/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<h3 class="text-xl font-bold text-deep-purple mb-2">Industrial Equipment Cover</h3>
								<p class="text-text/70">Heavy-duty cover for manufacturing equipment with weather-resistant coating.</p>
							</div>
						</div>
						<div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl hover:shadow-deep-purple/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-deep-purple/20 to-copper/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-deep-purple/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
								<div class="absolute inset-0 bg-deep-purple/0 group-hover:bg-deep-purple/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<h3 class="text-xl font-bold text-deep-purple mb-2">Gazebo Side Panels</h3>
								<p class="text-text/70">Set of replacement side panels with zipped doorways and clear window sections.</p>
							</div>
						</div>
						<div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl hover:shadow-copper/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-copper/20 to-primary/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-copper/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
