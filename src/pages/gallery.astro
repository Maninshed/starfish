---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Gallery - ${SITE_TITLE}`} description="View our portfolio of bespoke covers, canopies and canvas projects." />
	</head>
	<body class="bg-background text-text">
		<Header />
		<main>
			<!-- Page Header -->
			<section class="bg-gradient-to-br from-deep-purple via-primary to-electric-blue text-white py-20 relative overflow-hidden">
				<!-- Floating decorative shapes -->
				<div class="absolute top-10 left-20 w-32 h-32 bg-copper/20 rounded-full animate-blob blur-xl"></div>
				<div class="absolute bottom-10 right-20 w-40 h-40 bg-white/10 rounded-full animate-blob blur-xl" style="animation-delay: 2s;"></div>
				
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
					<h1 class="text-4xl lg:text-5xl font-bold mb-4">Our Gallery</h1>
					<p class="text-xl text-white/90 max-w-3xl">A showcase of our curious canvas creations</p>
				</div>
			</section>

			<!-- Filter Categories -->
			<section class="py-8 bg-white border-b border-primary/10">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex flex-wrap gap-4 justify-center">
						<button class="px-6 py-2 rounded-full bg-primary text-white font-medium hover:shadow-lg hover:shadow-primary/30 transition-all">All Projects</button>
						<button class="px-6 py-2 rounded-full bg-background text-text hover:bg-primary hover:text-white transition-colors font-medium hover:shadow-md">Marine</button>
						<button class="px-6 py-2 rounded-full bg-background text-text hover:bg-electric-blue hover:text-white transition-colors font-medium hover:shadow-md">Commercial</button>
						<button class="px-6 py-2 rounded-full bg-background text-text hover:bg-deep-purple hover:text-white transition-colors font-medium hover:shadow-md">Gazebo</button>
						<button class="px-6 py-2 rounded-full bg-background text-text hover:bg-copper hover:text-white transition-colors font-medium hover:shadow-md">PVC</button>
						<button class="px-6 py-2 rounded-full bg-background text-text hover:bg-primary hover:text-white transition-colors font-medium hover:shadow-md">Repairs</button>
					</div>
				</div>
			</section>

			<!-- Gallery Grid -->
			<section class="py-20 bg-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
						<!-- Project 1 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-primary/20 to-electric-blue/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-primary/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
								</svg>
								<div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-primary font-medium mb-2 block">Marine</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Narrowboat Cratch Cover</h3>
								<p class="text-text/70 text-sm">Custom fitted cratch cover with reinforced seams and clear PVC windows for optimal visibility.</p>
							</div>
						</div>

						<!-- Project 2 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-electric-blue/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-electric-blue/20 to-deep-purple/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-electric-blue/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
								</svg>
								<div class="absolute inset-0 bg-electric-blue/0 group-hover:bg-electric-blue/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-electric-blue font-medium mb-2 block">Commercial</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Industrial Equipment Cover</h3>
								<p class="text-text/70 text-sm">Heavy-duty cover for manufacturing equipment with weather-resistant coating and reinforced edges.</p>
							</div>
						</div>

						<!-- Project 3 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-deep-purple/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-deep-purple/20 to-copper/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-deep-purple/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
								<div class="absolute inset-0 bg-deep-purple/0 group-hover:bg-deep-purple/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-deep-purple font-medium mb-2 block">Gazebo</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Gazebo Side Panels</h3>
								<p class="text-text/70 text-sm">Set of replacement side panels with zipped doorways and clear window sections for a 3x3m gazebo.</p>
							</div>
						</div>

						<!-- Project 4 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-copper/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-copper/20 to-primary/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-copper/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
								</svg>
								<div class="absolute inset-0 bg-copper/0 group-hover:bg-copper/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-copper font-medium mb-2 block">Repairs</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Boat Canopy Refurbishment</h3>
								<p class="text-text/70 text-sm">Complete refurbishment of existing boat canopy with new fabric, framework and upgraded fittings.</p>
							</div>
						</div>

						<!-- Project 5 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-primary/20 to-electric-blue/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-primary/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
								</svg>
								<div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-primary font-medium mb-2 block">PVC</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Custom PVC Enclosure</h3>
								<p class="text-text/70 text-sm">Bespoke clear PVC enclosure for outdoor equipment protection with welded seams and reinforced edges.</p>
							</div>
						</div>

						<!-- Project 6 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-electric-blue/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-electric-blue/20 to-copper/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-electric-blue/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/>
								</svg>
								<div class="absolute inset-0 bg-electric-blue/0 group-hover:bg-electric-blue/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-electric-blue font-medium mb-2 block">Custom</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Porthole Bungs</h3>
								<p class="text-text/70 text-sm">Custom fabric and PVC porthole covers for marine vessels with secure fastening systems.</p>
							</div>
						</div>

						<!-- Project 7 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-primary/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-primary/20 to-electric-blue/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-primary/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
								</svg>
								<div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-primary font-medium mb-2 block">Marine</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Cockpit Canopy</h3>
								<p class="text-text/70 text-sm">Full cockpit canopy with clear PVC windows and removable side panels for flexible protection.</p>
							</div>
						</div>

						<!-- Project 8 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-deep-purple/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-deep-purple/20 to-primary/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-deep-purple/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
								</svg>
								<div class="absolute inset-0 bg-deep-purple/0 group-hover:bg-deep-purple/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-deep-purple font-medium mb-2 block">Commercial</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Warehouse Storage Cover</h3>
								<p class="text-text/70 text-sm">Large-scale storage cover for warehouse equipment with custom sizing and heavy-duty materials.</p>
							</div>
						</div>

						<!-- Project 9 -->
						<div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:shadow-copper/20 transition-all transform hover:-translate-y-2 hover:scale-105">
							<div class="aspect-[4/3] bg-gradient-to-br from-copper/20 to-electric-blue/20 flex items-center justify-center relative overflow-hidden">
								<svg class="w-24 h-24 text-copper/40 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
								</svg>
								<div class="absolute inset-0 bg-copper/0 group-hover:bg-copper/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
									<span class="text-deep-purple font-semibold">View Project</span>
								</div>
							</div>
							<div class="p-6">
								<span class="text-sm text-copper font-medium mb-2 block">Gazebo</span>
								<h3 class="text-xl font-bold text-deep-purple mb-2">Custom Gazebo Roof</h3>
								<p class="text-text/70 text-sm">Bespoke gazebo roof panel with reinforced stitching and weather-resistant coating.</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="py-20 bg-gradient-to-br from-deep-purple via-primary to-electric-blue text-white relative overflow-hidden">
				<!-- Floating decorative shapes -->
				<div class="absolute top-10 left-20 w-32 h-32 bg-copper/20 rounded-full animate-blob blur-xl"></div>
				<div class="absolute bottom-10 right-20 w-40 h-40 bg-white/10 rounded-full animate-blob blur-xl" style="animation-delay: 2s;"></div>
				
				<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
					<h2 class="text-3xl lg:text-4xl font-bold mb-6">Have a Project in Mind?</h2>
					<p class="text-xl text-white/90 mb-8">We'd love to discuss how we can help with your bespoke cover or canopy requirements.</p>
					<a href="/contact" class="inline-block bg-copper text-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-deep-purple transition-all transform hover:-translate-y-1 hover:shadow-lg hover:shadow-copper/30">
						Get in Touch
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
