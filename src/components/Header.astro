---
import Logo from './Logo.astro';
---

<header class="bg-deep-purple sticky top-0 z-50 border-b-2 border-copper/30">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <Logo />
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-white/90 hover:text-copper transition-colors font-medium relative group">
          Home
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-copper transition-all group-hover:w-full"></span>
        </a>
        <a href="/services" class="text-white/90 hover:text-copper transition-colors font-medium relative group">
          Services
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-copper transition-all group-hover:w-full"></span>
        </a>
        <a href="/gallery" class="text-white/90 hover:text-copper transition-colors font-medium relative group">
          Gallery
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-copper transition-all group-hover:w-full"></span>
        </a>
        <a href="/about" class="text-white/90 hover:text-copper transition-colors font-medium relative group">
          About
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-copper transition-all group-hover:w-full"></span>
        </a>
        <a href="/contact" class="bg-primary text-white px-6 py-2 rounded-full hover:bg-electric-blue hover:shadow-lg hover:shadow-primary/50 transition-all font-medium transform hover:-translate-y-0.5">
          Start a Project
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-white/10 transition-colors">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-3">
        <a href="/" class="text-white/90 hover:text-copper transition-colors font-medium py-2">Home</a>
        <a href="/services" class="text-white/90 hover:text-copper transition-colors font-medium py-2">Services</a>
        <a href="/gallery" class="text-white/90 hover:text-copper transition-colors font-medium py-2">Gallery</a>
        <a href="/about" class="text-white/90 hover:text-copper transition-colors font-medium py-2">About</a>
        <a href="/contact" class="bg-primary text-white px-6 py-2 rounded-full hover:bg-electric-blue transition-colors font-medium text-center">Start a Project</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
