---
const today = new Date();
---

<footer class="bg-deep-purple text-white py-12 relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-copper/10 rounded-full blur-2xl"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Company Info -->
      <div>
        <h3 class="text-xl font-bold mb-4">Starfish Covers & Canvas</h3>
        <p class="text-white/80 mb-4">Canvas, PVC, covers, panels and practical fabric wizardry. From canal boats to garden shelters, if it needs covering, enclosing, repairing or weatherproofing, we can probably make it.</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-copper">Explore</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-white/80 hover:text-copper transition-colors">Home</a></li>
          <li><a href="/services" class="text-white/80 hover:text-copper transition-colors">Services</a></li>
          <li><a href="/gallery" class="text-white/80 hover:text-copper transition-colors">Gallery</a></li>
          <li><a href="/about" class="text-white/80 hover:text-copper transition-colors">About</a></li>
          <li><a href="/contact" class="text-white/80 hover:text-copper transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-copper">Get in Touch</h3>
        <ul class="space-y-2 text-white/80">
          <li>Phone: 01234 567890</li>
          <li>Email: info@starfishcovers.co.uk</li>
          <li>Location: United Kingdom</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/20 mt-8 pt-8 text-center text-white/60">
      <p>&copy; {today.getFullYear()} Starfish Covers & Canvas. Made with fabric, thread and a bit of magic.</p>
    </div>
  </div>
</footer>
